{
    "compilerOptions": {
        "module": "es6",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "declaration": true,
        "sourceMap": true,
        "rootDir": ".",
        "outDir": "dist/",
        "lib": ["es2019"],
        "types": ["node", "jest"]
    },
    "include": ["source/**/*", "test/**/*"],
    "typedocOptions": {
        "name": "Iterable Observer",
        "includeVersion": true,
        "excludeExternals": true,
        "excludePrivate": true,
        "plugin": ["typedoc-plugin-mdn-links"],
        "readme": "./ReadMe.md",
        "navigationLinks": {
            "GitHub": "https://github.com/idea2app/iterable-observer"
        }
    }
}
